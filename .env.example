# === Social Media Liaison Agent — Doc Weather / Charles Clottin ===

# Dry-run: log posts/replies without calling platform APIs
DRY_RUN=true

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_SECRET=change-me-to-a-long-random-string

# Watch folder for new videos (absolute path recommended)
VIDEO_INBOX=/Users/charlesclottin/Desktop/Doc Weather Content/videos/ready
# Master library (videos + articles + bundles)
CONTENT_LIBRARY=/Users/charlesclottin/Desktop/Doc Weather Content
# Optional: also watch CapCut / other export folders
# VIDEO_INBOX_EXTRA=/Users/charlesclottin/Desktop/shorts to upload
# Legacy folder still OK if you prefer:
# VIDEO_INBOX=/Users/charlesclottin/Desktop/Ready to Post

# === SpaceXAI / xAI (titles, descriptions, hashtags, comment replies) ===
# https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.5

# === X (Twitter) — OAuth 1.0a user context ===
# https://developer.x.com  scopes: tweet.read tweet.write users.read media.write offline.access
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# === Instagram (via Meta Graph API — Business/Creator + Facebook Page) ===
# https://developers.facebook.com/docs/instagram-api
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# === TikTok Content Posting API ===
# https://developers.tiktok.com/doc/content-posting-api-get-started
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=

# === YouTube Data API v3 + OAuth ===
# https://console.cloud.google.com  YouTube Data API v3
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_TOKEN_FILE=data/youtube_token.json
YOUTUBE_CHANNEL_ID=
# Or service-style env (if using stored refresh token):
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# === Alerts (when away) ===
# macOS notifications always on when local; optional webhook (Discord/Slack)
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# Feature toggles
AI_CONTENT_ENABLED=true
AUTO_ENGAGE_ENABLED=true
ANALYTICS_ENABLED=true
CONTINUOUS_MONITOR_ENABLED=true
